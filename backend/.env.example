# Storage
DOWNLOAD_DIR=/downloads
FILE_TTL_SECONDS=3600

# Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# yt-dlp / aria2c tuning
ARIA2C_CONNECTIONS=16
ARIA2C_SPLIT=16
ARIA2C_MIN_SPLIT_SIZE=1M
# Generous on purpose: aria2c's defaults abort transfers on hosts that are
# slow to complete a TLS handshake.
ARIA2C_CONNECT_TIMEOUT=60
ARIA2C_TIMEOUT=60
SOCKET_TIMEOUT=30
RETRIES=5

# Limits
MAX_CONCURRENT_JOBS=2
MAX_DURATION_SECONDS=14400

# Rate limiting (sliding window, per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
# CIDRs of reverse proxies whose X-Forwarded-For may be trusted. Loopback and
# RFC1918 peers are always trusted, which covers the bundled nginx. Add the
# edge proxy's range here if the API sits behind something else.
# TRUSTED_PROXIES=198.51.100.0/24

# Download history (SQLite). Leave DATABASE_PATH unset to keep the database
# beside the downloads in DOWNLOAD_DIR.
HISTORY_ENABLED=true
# DATABASE_PATH=/downloads/history.db

# WebSocket progress streaming
WS_POLL_INTERVAL=0.5
WS_MAX_UPDATES=3600

# CORS (comma separated, or * for all)
CORS_ORIGINS=*
