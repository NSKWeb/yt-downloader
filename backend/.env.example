# Storage
DOWNLOAD_DIR=/downloads
FILE_TTL_SECONDS=3600

# Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# yt-dlp / aria2c tuning
ARIA2C_CONNECTIONS=16
ARIA2C_SPLIT=16
ARIA2C_MIN_SPLIT_SIZE=1M
SOCKET_TIMEOUT=30
RETRIES=5

# Limits
MAX_CONCURRENT_JOBS=2
MAX_DURATION_SECONDS=14400

# CORS (comma separated, or * for all)
CORS_ORIGINS=*
