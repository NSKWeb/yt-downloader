# Keep the build context to what the image actually needs. Without this the
# whole repo — .git history, tests, caches — is uploaded to the daemon and any
# broad COPY would bake it into a layer.
.git
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
.env
.env.*
!.env.example
*.log
*.db
*.db-wal
*.db-shm
tests/
downloads/
docker-compose.yml
Dockerfile
.dockerignore
README.md
AGENTS.md
